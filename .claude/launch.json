{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "genomecurator",
      "runtimeExecutable": "mamba",
      "runtimeArgs": [
        "run",
        "-n",
        "genomecurator",
        "python",
        "-m",
        "genomecurator",
        "serve",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "static-preview",
      "runtimeExecutable": "mamba",
      "runtimeArgs": [
        "run",
        "-n",
        "genomecurator",
        "python",
        "-m",
        "http.server",
        "8010",
        "--directory",
        "docs"
      ],
      "port": 8010
    }
  ]
}
