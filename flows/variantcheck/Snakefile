# Independent variant calls for every genome of a FASTA: snippy (--ctgs, simulated 20x reads) -> lofreq on snippy's BAM -> one table.
# The Snakemake version of genomecurator/variantcall.py (both are kept until this one is complete; they must give the same calls).
#
# config: fasta (all genomes, one record each), reference (FASTA), snippy_env / lofreq_env (conda environment *directories*, used with --use-conda), cpus_per_job,
#         repo (the app's folder, for genomecurator/flowlogic.py), mutations (the mutation-profile run's mutations.tsv), judged (genome ids that pass the N limit, one per line),
#         itr_lo / itr_hi (the window outside which the inverted terminal repeats lie), seqid (reference name for the BED), min_genomes (a site needs this many disagreeing genomes for the BED)
# Per genome only the small `calls/<id>.tsv` is kept; snippy's folder (BAM, VCF, ...) is temporary and deleted once lofreq has read it.
import re

FASTA = config["fasta"]
REF = config["reference"]


def read_ids(path):
    ids = []
    for line in open(path, encoding="utf-8"):
        if line.startswith(">"):
            ids.append(line[1:].split()[0])
    return ids


IDS = read_ids(FASTA)
assert len(IDS) == len(set(IDS)), "genome ids are not unique"
assert all(re.fullmatch(r"[A-Za-z0-9_.:\-]+", i) for i in IDS), "genome ids must be plain characters (they become file names)"
SAFE = {i: re.sub(r"[^A-Za-z0-9_.\-]", "_", i) for i in IDS}          # file-name form of an id (`private:X` -> `private_X`)
BY_SAFE = {v: k for k, v in SAFE.items()}
assert len(BY_SAFE) == len(IDS), "two genome ids give the same file name"


rule all:
    input:
        "variantcall.tsv",
        "variantcall.genomes.txt",
        "concordance.json",
        "review_sites.bed",


rule one_genome:
    """The record of one genome as its own FASTA."""
    input:
        FASTA,
    output:
        temp("genomes/{sid}.fa"),
    params:
        gid=lambda wc: BY_SAFE[wc.sid],
    script:
        "scripts/one_genome.py"


rule snippy:
    input:
        fa="genomes/{sid}.fa",
        ref=REF,
    output:
        d=temp(directory("snippy/{sid}")),
    threads: config.get("cpus_per_job", 2)
    conda:
        config["snippy_env"]
    log:
        "logs/snippy/{sid}.log",
    shell:
        "snippy --cpus {threads} --outdir {output.d} --ref $(readlink -f {input.ref}) --ctgs {input.fa} --force > {log} 2>&1"


rule lofreq:
    input:
        d="snippy/{sid}",
    output:
        vcf=temp("lofreq/{sid}.vcf"),
    conda:
        config["lofreq_env"]
    log:
        "logs/lofreq/{sid}.log",
    shell:
        "lofreq call -f {input.d}/reference/ref.fa -o {output.vcf} {input.d}/snps.bam > {log} 2>&1"


rule calls:
    """Both callers' single-base substitutions of one genome in one small table (kept)."""
    input:
        snippy="snippy/{sid}",
        lofreq="lofreq/{sid}.vcf",
    output:
        "calls/{sid}.tsv",
    params:
        gid=lambda wc: BY_SAFE[wc.sid],
    script:
        "scripts/calls.py"


rule collect:
    input:
        expand("calls/{sid}.tsv", sid=list(BY_SAFE)),
    output:
        tsv="variantcall.tsv",
        genomes="variantcall.genomes.txt",
    script:
        "scripts/collect.py"


rule concordance:
    """Where the run's own calls, snippy and lofreq disagree: per-site report (JSON) and a BED of sites to look at. Nothing is masked or removed."""
    input:
        tsv="variantcall.tsv",
        genomes="variantcall.genomes.txt",
        mutations=config["mutations"],
        judged=config["judged"],
    output:
        json="concordance.json",
        bed="review_sites.bed",
    script:
        "scripts/concordance.py"
